{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30,
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
